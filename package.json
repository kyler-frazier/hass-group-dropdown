{
  "name": "hass-group-dropdown",
  "version": "0.2.2",
  "private": true,
  "description": "Home Assistant tile card with a caret that drops down a group's members.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hass:up": "docker compose up -d --wait",
    "hass:down": "docker compose down --volumes",
    "test": "playwright test",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=22"
  }
}
